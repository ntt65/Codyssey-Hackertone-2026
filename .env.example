# 오늘 나들이 환경변수 예시. 키 이름만 적고 실제 값은 .env 에만 넣어요 (커밋 금지).
# 사용: cp .env.example .env → 값 채우기 → set -a; source .env; set +a

# 서울시 문화행사 실시간 조회 (없으면 공개 샘플 5건)
LAB678_SEOUL_API_KEY=

# 카카오: REST 키는 출발지 검색·대중교통 경로(서버 전용), JavaScript 키는 지도 표시(브라우저 공개용, 도메인 등록 필요)
LAB678_KAKAO_REST_API_KEY=
LAB678_KAKAO_JAVASCRIPT_KEY=

# AI 대화 해석 (없으면 프론트 규칙 기반 해석으로 동작)
# PROVIDER: codyssey(기본, 해커톤 제공 주소) | anthropic | openai
LAB678_NAITO_API_KEY=
LAB678_NAITO_PROVIDER=codyssey
LAB678_NAITO_MODEL=claude-sonnet-4

# 한국관광공사 TourAPI 문화시설 (선택)
LAB678_TOUR_API_KEY=

# 배포 서버용
LAB678_ALLOWED_ORIGINS=
LAB678_FILE_VOICE=off
